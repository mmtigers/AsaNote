{
  "name": "@note/core",
  "version": "0.0.0",
  "private": true,
  "description": "あさノート・よるノートの共通コード。ビルドなしで TS のソースをそのまま公開し、各アプリ側(Next.js)が取り込んで変換する。",
  "exports": {
    "./auth": "./src/auth.tsx",
    "./components/*": "./src/components/*.tsx",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@holiday-jp/holiday_jp": "^2.5.2",
    "@supabase/supabase-js": "^2.118.0"
  },
  "peerDependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "next": "^16.4.2",
    "react-dom": "19.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
