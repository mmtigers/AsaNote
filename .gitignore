# モノレポのルート。各アプリ固有の無視設定(.next / coverage / next-env.d.ts など)は
# apps/*/.gitignore に置く。ここには、ルートで生成されるものだけを書く。

# dependencies(npm workspaces のため、依存はルートの node_modules に集約される)
/node_modules

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# env files
.env*.local
.env

# vercel
.vercel

# supabase CLIのローカル作業用ディレクトリ(functions serve/linkの度に生成される)
supabase/.temp
apps/*/supabase/.temp
